{
  "name": "back_end",
  "version": "1.0.0",
  "main": "index.js",
  "scripts": {
    "test": "echo \"Error: no test specified\" && exit 1",
    "test:e2e": "tsx --env-file=.env --test test/e2e/**/*.e2e.spec.ts",
    "test:e2e-concurrency1": "tsx --env-file=.env --test --test-concurrency=1 test/e2e/**/*.e2e.spec.ts",
    "test:int-concurrency1": "tsx --env-file=.env --test --test-concurrency=1 test/int/**/*.spec.ts",
    "test:unit": "tsx --env-file=.env --test test/unit/**/*.spec.ts",
    "dev": "ts-node-dev --respawn src/server.ts",
    "build": "tsc",
    "start": "node dist/main/server.js",
    "generate": "ts-node src/main/scripts/generateData.ts",
    "lint": "eslint --cache",
    "ci": "npm run lint && npm run test:unit && npm run test:int-concurrency1 && npm run test:e2e-concurrency1 && npm run build"
  },
  "author": "",
  "license": "ISC",
  "description": "",
  "dependencies": {
    "bcrypt": "^6.0.0",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "exceljs": "^4.4.0",
    "express": "^5.1.0",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^9.7.1",
    "sequelize": "^6.37.7",
    "uuid": "^14.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/bcrypt": "^6.0.0",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^25.9.2",
    "@types/supertest": "^7.2.0",
    "@types/uuid": "^10.0.0",
    "eslint": "^10.5.0",
    "globals": "^17.6.0",
    "supertest": "^7.2.2",
    "ts-node-dev": "^2.0.0",
    "tsx": "^4.22.4",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.61.1"
  }
}
